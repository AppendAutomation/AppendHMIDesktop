{
  "name": "append-hmi-desktop",
  "productName": "Append HMI Desktop",
  "version": "1.2.2",
  "description": "Append HMI Desktop: runs Append HMI Studio applications (.ahmi) on operator PCs",
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "build-comms": "node studio/comms/scripts/publish.mjs",
    "fetch-nsis": "node scripts/fetch-nsis.mjs",
    "test": "node --test src/test/args.test.js src/test/project.test.js src/test/shortcuts.test.js src/test/settings.test.js src/test/nsis.test.js src/test/packaging.test.js",
    "dist-win": "node scripts/dist-win.mjs",
    "dist-linux": "node scripts/dist-linux.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AppendAutomation/AppendHMIDesktop.git"
  },
  "keywords": [
    "HMI",
    "SCADA",
    "PLC",
    "runtime"
  ],
  "author": "Append Automation <dhuntlinux@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/AppendAutomation/AppendHMIDesktop/issues"
  },
  "homepage": "https://github.com/AppendAutomation/AppendHMIDesktop",
  "dependencies": {
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.7"
  }
}
